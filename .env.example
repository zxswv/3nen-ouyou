# このファイルをコピーして値を入れる。実際の値はコミットしないこと。
# バックエンドは環境変数から読む（backend/src/main/resources/application.yml）。

# --- データベース（PostgreSQL 17）---
DB_URL=jdbc:postgresql://localhost:5432/attendance
DB_USERNAME=postgres
DB_PASSWORD=ここにインストール時に決めたpostgresのパスワード

# --- JWT（32文字以上のランダムな文字列。各自で生成する）---
JWT_SECRET=ここに32文字以上のランダム文字列
JWT_EXPIRATION_MINUTES=480

# --- CORS（フロントエンドのURL）---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- 外部API（使うときだけ）---
GEOCODING_API_KEY=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- フロントエンド（frontend/.env.local に書く）---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
